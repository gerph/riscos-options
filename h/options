#ifndef OPTIONS_H
#define OPTIONS_H

#include "kernel.h"
#include "optlist.h"

#define BAD_OPENTYPE    (0)
#define BAD_CANTOPEN    (1)
#define BAD_OUTOFMEMORY (2)

typedef struct optfile {
  void *next;
  unsigned int magic;
  optg *groups;
  char *writefile;
  int needtowrite;
} optfile;

typedef enum {
  ot_absolute,
  ot_choices
} opentype;

/**************************************************** JRF *********
 Function:     readenum
 Description:  Read an enumeration
 Parameters:   string-> the string to match
               list-> the enumeration blocks list
 Returns:      index of the item, or -1 if not known
 ******************************************************************/
int readenum(char *string,char *list);

/**************************************************** JRF *********
 Function:     readbool
 Description:  Read a boolean value
 Parameters:   str-> string to decode
 Returns:      0, 1, or -1 if not known
 ******************************************************************/
int readbool(char *str);

/**************************************************** JRF *********
 Function:     readgroup
 Description:  Read a whole group entry from a file
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for transfer
                        b0-7 = type
                                0 = options
                                1 = list
                                undefined
                        b8-31 = undefined
               buffer-> buffer to place data in
               buflen = buffer length (or -ve to return -ve length required)
 Returns:      size of data written (or -ve size of buffer, or 0 if error)
 ******************************************************************/
int readgroup(optg *grps,char *grpname,int flags,char *buffer,int buflen);

/**************************************************** JRF *********
 Function:     writegroup
 Description:  Write out a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for transfer
                        b0-7 = type
                                0 = options
                                1 = list
                                undefined
                        b8-31 = undefined
               buffer-> buffer to place data in
               buflen = buffer length (or -ve to return -ve length required)
 Returns:      error block if error
 ******************************************************************/
_kernel_oserror *writegroup(optg *grps,char *grpname,int flags,char **buffer);

/**************************************************** JRF *********
 Function:     readvalue_tobuffer
 Description:  Read a particular value from a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               id-> the id we want to read
               buffer-> buffer to store into
               buflen = length of buffer
 Returns:      number of characters written, or -ve number of characters
               needed, or 0 if failed
 ******************************************************************/
int readvalue_tobuffer(optg *grps,char *grpname,char *id,char *buffer,int buflen);

/**************************************************** JRF *********
 Function:     readvalue
 Description:  Read a particular value from a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for accessing the data
               id-> the id we want to read, or the line number for
                    list groups
 Returns:      pointer to value, or 0 if not found, 1 if could not convert
 ******************************************************************/
char *readvalue(optg *grps,char *grpname,int flags,char *id);

/**************************************************** JRF *********
 Function:     writevalue
 Description:  Write a value into a group (creating the group if
               necessary)
 Parameters:   grps-> the file we're adding to
               grpname-> the name of the group we're adding (to)
               flags = flags
               id-> the id we're adding (or NULL if it's a comment)
               value-> the value to add (may be NULL for list groups)
 Returns:      NULL if successful, error pointer if not
 ******************************************************************/
_kernel_oserror *writevalue(optg *grps,char *grpname,int flags,char *id,char *value);

/**************************************************** JRF *********
 Function:     deletevalue
 Description:  Remove a particular value from a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for accessing the data
               id-> the id we want to read, or the line number for
                    list groups
 Returns:      pointer to value, or 0 if not found
 ******************************************************************/
_kernel_oserror *deletevalue(optg *grps,char *grpname,int flags,char *id);

/*********************************************** <c> Gerph *********
 Function:     openfile
 Description:  Open a file and remember details about it, returning
               an opaque handle
 Parameters:   type = type of file access
               file-> the file to use
               app-> the application
               dir-> directory to use if not there
 Returns:      handle to use in future, or :
                 0 : invalid file access type
                 1 : file could not be read/out of memory
 ******************************************************************/
int openfile(opentype type, char *file, char *app, char *dir);

/*********************************************** <c> Gerph *********
 Function:     closefile
 Description:  Close a file, writing it out if necessary
 Parameters:   handle-> the file handle (non-opaque value)
 Returns:      pointer to error, or NULL if ok
 ******************************************************************/
_kernel_oserror *closefile(optfile *file);

/******************************************************************
 Function:     closeall
 Description:  Close all files
 Parameters:   none
 Returns:      none
 ******************************************************************/
void closeall(void);

/*********************************************** <c> Gerph *********
 Function:     getsafehandle
 Description:  Get a safe handle from the opaque value returned
 Parameters:   opaque = opaque handle to check and get the safe
               value from
 Returns:      handle to use, or NULL if it's invalid
 ******************************************************************/
optfile *getsafehandle(int handle);

#endif
