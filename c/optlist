/**************************************************** JRF *********
 Function:     optg_create
 Description:  Creates an options group block into which optlist
               blocks can be added
 Parameters:   none
 Returns:      pointer to optg block, or NULL if failed
 ******************************************************************/
optg *optg_create(void)
{
  optg *grp=malloc(sizeof(optg));
  if (grp==NULL)
    return NULL;
  grp->next=NULL; /* nothing there yet */
  /* Ensure that the default group exists */
  grp->group=opt_create("$",opt_options);
  if (grp->group==NULL)
  {
    free(grp);
    return NULL;
  }
  return grp; /* return it */
}


/**************************************************** JRF *********
 Function:     optg_add
 Description:  Add an optlist to the group of options list
 Parameters:   top-> the group to add this to
               opts-> the list to add
 Returns:      0 for success, 1 if failed
 ******************************************************************/
int optg_add(optg *top,opts *opt)
{
  optg *newgrp;
  if (top==NULL)
    return 1;
  newgrp=malloc(sizeof(optg));
  if (newgrp==NULL)
    return 1;
  while (top->next!=NULL)
    top=top->next;          /* find the end of the list */
  newgrp->next=NULL; /* nothing there yet */
  newgrp->group=opt;
  top->next=newgrp;
  return 0; /* return it */
}

/**************************************************** JRF *********
 Function:     optg_show
 Description:  Show all the options in the blocks
 Parameters:   file-> the file to output to
               grp-> the group of options
               term-> the terminator to use
 Returns:      none
 ******************************************************************/
void optg_show(FILE *file,optg *grp,char *term)
{
  while (grp!=NULL)
  {
    opt_show(file,grp->group,term);
    grp=grp->next;
    if (grp!=NULL)
      fprintf(file,"[%s]\n",grp->group->name);
  }
}

/**************************************************** JRF *********
 Function:     optg_destroy
 Description:  Destroy the entire options group set
 Parameters:   grp-> the groups to destroy
 Returns:      none
 ******************************************************************/
void optg_destroy(optg *grp)
{
  while (grp!=NULL)
  {
    optg *next=grp->next;
    opt_destroy(grp->group);
    free(grp); grp=next;
  }
}

/*********************************************** <c> Gerph *********
 Function:     opt_create
 Description:  Creates a opt block with nothing in it
 Parameters:   name-> name of this group
               type = type of this group (options/list)
 Returns:      pointer to a opt block, or NULL if failed
 ******************************************************************/
opts *opt_create(char *name,opttype type)
{
  opts *opt=malloc(sizeof(opts));
  if (opt==NULL)
    return NULL;
  opt->name=strdup(name);
  if (opt->name==NULL)
  {
    free(opt);
    return NULL;
  }
  opt->type=type;
  opt->head=NULL; /* nothing there yet */
  opt->tail=NULL; /* nothing there yet */
  return opt; /* return it */
}

/*********************************************** <c> Gerph *********
 Function:     opt_change
 Description:  Change an option value
 Parameters:   opt-> optval to change
               data-> value to change to
 Returns:      1 if failed, 0 otherwise
 ******************************************************************/
int opt_change(optval *opt,char *data)
{
  char *nval=strdup(data);
  if (nval==NULL)
    return 1;
  free(opt->value);
  opt->value=nval;
  return 0;
}

/*********************************************** <c> Gerph *********
 Function:     opt_add
 Description:  Add an option to the opt block
 Parameters:   opt-> opt block
               id-> identifier name (will be copied)
               indent = indentation level or OPT_COMMENT
               data-> data to add (will be copied)
 Returns:      0 for success, 1 if failed
 ******************************************************************/
int opt_add(opts *opt,char *id,int indent,char *data)
{
  optval *noptval=malloc(sizeof(optval));
  if (noptval==NULL) return 1; /* failed */
  noptval->next=NULL;          /* not linked to anything */

  noptval->indent=indent;
  if (id!=NULL)
  {
    noptval->id=strdup(id);      /* copy the optval */
    if (noptval->id==NULL)
    { free(noptval); return 1; } /* failed */
  }
  else
    noptval->id=NULL;

  if (data!=NULL)
  {
    noptval->value=strdup(data); /* copy the optval */
    if (noptval->value==NULL)
    { free(noptval->id); free(noptval); return 1; } /* failed */
  }
  else
    noptval->value=NULL;

  if (opt->head==NULL)
  {
    opt->head=noptval;
    opt->tail=noptval;
  }
  else
  {
    opt->tail->next=noptval; /* link us on to the end of the list */
    opt->tail=noptval;       /* and make us the end of the list */
  }
  return 0; /* success */
}

/*********************************************** <c> Gerph *********
 Function:     opt_firstopt
 Description:  Return the first optval of the block
 Parameters:   opt-> opt block
 Returns:      pointer to the optval, or NULL if none
 ******************************************************************/
optval *opt_firstopt(opts *opt)
{
  return opt->head; /* return the head item */
}

/*********************************************** <c> Gerph *********
 Function:     opt_nextopt
 Description:  Return the next optval of the block
 Parameters:   opt-> last optval block
 Returns:      pointer to the next optval, or NULL if none
 ******************************************************************/
optval *opt_nextopt(optval *opt)
{
  return opt->next;
}

/*********************************************** <c> Gerph *********
 Function:     opt_remove
 Description:  Remove a block
 Parameters:   top-> the top entry
               opt-> the optval to remove
 Returns:      NULL, to store if you wish
 ******************************************************************/
optval *opt_remove(opts *top,optval *opt)
{
  optval *cur=top->head;  /* the current optval */
  optval *last=NULL;      /* the last optval we looked at */
  while (cur!=NULL)
  {
    optval *next=cur->next;
    if (cur==opt)
    {
      free(cur->value);       /* free optval itself */
      free(cur->id);          /* free optval itself */
      free(cur);              /* and free the block */
      if (last==NULL) top->head=next;
      else last->next=next;    /* relink us */
      cur=last;
    }
    last=cur; cur=next; /* move on to next */
  }
  return NULL;
}

/*********************************************** <c> Gerph *********
 Function:     opt_destroy
 Description:  Destroy an entire opt block
 Parameters:   opt-> the opt block to kill
 Returns:      NULL (for assigning to the variable you used if you want)
 ******************************************************************/
opts *opt_destroy(opts *opt)
{
  optval *cur=opt->head;  /* the current optval */
  optval *last;           /* the last optval we looked at */
  while (cur!=NULL)
  {
    last=cur; cur=cur->next; /* move on to next */
    if (last->value)
      free(last->value);       /* free optval itself */
    if (last->id)
      free(last->id);          /* free optval itself */
    free(last);              /* and free the block */
  }
  free(opt);
  return NULL;
}

/*********************************************** <c> Gerph *********
 Function:     optg_readfile
 Description:  Read an options file in
 Parameters:   file-> filename
 Returns:      pointer to opts, or NULL if failed
 ******************************************************************/
optg *optg_readfile(char *file)
{
  optg *ogrp=optg_create();
  opts *olist;
  int textlen;
  int textoffset=0;
  void *textf;
  char *line;

  if (ogrp==NULL)
    return NULL; /* Failed to create */

  olist=ogrp->group; /* Start with the default group */

  textf=loadfile(file,&textlen);
  if (textf==NULL)
  {
    optg_destroy(ogrp);
    return NULL;
  }

  while ((line=readline(textf,textlen,&textoffset))!=NULL)
  {
    char *sep;
    char *id,*value;
    int indent=0;

    while (*line==' ' || *line=='\t')
      indent++,line++;

    if (*line=='#')
    { /* It's a comment */
      opt_add(olist,NULL,indent,&line[1]);
      continue;
    }
    if (*line=='[')
    { /* It's a new group - not finished */
      char *endbracket=strchr(line,']');
      if (endbracket==NULL)
        break; /* broken group -
                  maybe we should abort till the next group block ? */
      *endbracket='\0';
      olist=opt_create(&line[1],opt_options);
      if (olist==NULL)
        break; /* Out of memory; abort */
      if (optg_add(ogrp,olist))
      {
        opt_destroy(olist);
        break; /* Failed to add, abort */
      }
      continue;
    }

    if (olist->type==opt_options)
    {
      sep=strchr(line,':');
      if (sep==NULL)
      { /* It's not a valid line - assume it's a blank line */
        opt_add(olist,NULL,indent,NULL);
        continue;
      }
      id=line;
    }
    else
      sep=line;

    *sep='\0'; /* Terminate at : */
    value=sep+1;

    while ((sep>line) && ((sep[-1]==' ') || (sep[-1]=='\t')))
      sep--, sep[0]='\0'; /* Remove trailing spaces */

    while (*value==' ' || *value=='\t')
      value++; /* Skip leading spaces on value */

    /* Now strip any trailing spaces from the value */
    {
      char *end=&value[strlen(value)-1];
      while (end>value && (*end==' ' || *end=='\t'))
        end--;
      end[1]='\0';

      /* Check whether we're quote terminated */
      if (value[0]=='"')
      {
        if (end[0]=='"' && end!=value)
        { /* It's a valid quoted string, skip spaces */
          end[0]='\0'; value++;
        }
        else
        { /* It's not valid so we assume it's a blank line */
          opt_add(olist,NULL,indent,NULL);
          continue;
        }
      }
    }

    if (olist->type==opt_list)
      id=value, value=NULL; /* */

    if (opt_add(olist,id,indent,value))
    { /* It failed to add the entry - we've got to abort */
      optg_destroy(ogrp);
      free(textf); /* Destroy the text file we allocated space for */
      return NULL;
    }
  }
#ifdef DEBUG
  printf("done!\n");
#endif
  return ogrp;
}

/*********************************************** <c> Gerph *********
 Function:     opt_show
 Description:  Output the opt to a file (or the screen)
 Parameters:   file-> FILE to send to
               opt-> opt list to output
               term-> terminator to use
 Returns:      none
 ******************************************************************/
void opt_show(FILE *file,opts *opt,char *term)
{
  optval *now=opt_firstopt(opt);
  while (now!=NULL)
  {
    int spcs=opt_indent(now);
    char *id;
    char *value;
    while (spcs-->0)
      putc(' ',file);

    id=opt_id(now);
    value=opt_value(now);
    if (!id)
    {
      if (!value)
        fprintf(file,"%s",term);
      else
        fprintf(file,"#%s%s",value,term);
    }
    else
    {
      if (value)
      {
        if ((value[0]==' ') || (strchr(value,'"')!=NULL) ||
            (value[strlen(value)-1]==' '))
          fprintf(file,"%s: \"%s\"%s",id,value,term);
        else
          fprintf(file,"%s: %s%s",id,value,term);
      }
      else
        fprintf(file,"%s%s",id,term);
    }

    now=opt_nextopt(now);
  }
}

/*********************************************** <c> Gerph *********
 Function:     opt_findopt
 Description:  Find a particular optval of opt in a opt block
 Parameters:   opt-> opt list to search
               find-> the optval to search for
 Returns:      pointer to optval entry, or NULL if not found
 ******************************************************************/
optval *opt_findopt(opts *opt,char *find)
{
  optval *now=opt_firstopt(opt);
  while (now!=NULL)
  {
    char *id=opt_id(now);
    if (id && strcmp(find,id)==0)
      return now;
    now=opt_nextopt(now);
  }
  return NULL;
}

/*********************************************** <c> Gerph *********
 Function:     opt_findiopt
 Description:  Find a particular optval of opt in a opt block
               insensitively
 Parameters:   opt-> opt list to search
               find-> the optval to search for
 Returns:      pointer to optval entry, or NULL if not found
 ******************************************************************/
optval *opt_findiopt(opts *opt,char *find)
{
  optval *now=opt_firstopt(opt);
  while (now!=NULL)
  {
    char *id=opt_id(now);
    if (id && stricmp(find,id)==0)
      return now;
    now=opt_nextopt(now);
  }
  return NULL;
}
