/**************************************************** JRF *********
 Function:     readvalue
 Description:  Read a particular value from a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for accessing the data
               id-> the id we want to read, or the line number for
                    list groups
 Returns:      pointer to value, or 0 if not found
 ******************************************************************/
char *readvalue(optg *grps,char *grpname,int flags,char *id)
{
  opts *list=optg_find(grps,grpname);
  optval *val;

  if (list==NULL)
  {
#ifdef DEBUG
    printf("Group doesn't exist\n");
#endif
    return NULL; /* No such group, so return 'not known' */
  }

  if ((opttype)(flags & 255) != list->type)
    return (char *)1;

  switch (list->type)
  {
    case opt_options:
      val=opt_findiopt(list,id);
      if (val==NULL)
        return NULL; /* No value */
      return opt_value(val);

    case opt_list:
      val=opt_findoptbynum(list,(int)id);
      if (val==NULL)
        return NULL; /* No value */
      return opt_id(val);
  }
  return NULL; /* Erm... should never happen */
}

/**************************************************** JRF *********
 Function:     deletevalue
 Description:  Remove a particular value from a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for accessing the data
               id-> the id we want to read, or the line number for
                    list groups
 Returns:      pointer to value, or 0 if not found
 ******************************************************************/
_kernel_oserror *deletevalue(optg *grps,char *grpname,int flags,char *id)
{
  opts *list=optg_find(grps,grpname);
  optval *val;

  if (list==NULL)
  {
#ifdef DEBUG
    printf("Group doesn't exist\n");
#endif
    return NULL; /* No such group, so return 'not known' */
  }

  if ((opttype)(flags & 255) != list->type)
    return err_CantConvert;

  switch (list->type)
  {
    case opt_options:
      val=opt_findiopt(list,id);
      if (val==NULL)
        return NULL; /* No value */
      opt_remove(list,val);

    case opt_list:
      val=opt_findoptbynum(list,(int)id);
      if (val==NULL)
        return NULL; /* No value */
      opt_remove(list,val);
  }
  return NULL; /* Erm... should never happen */
}

/**************************************************** JRF *********
 Function:     writevalue
 Description:  Write a value into a group (creating the group if
               necessary)
 Parameters:   grps-> the file we're adding to
               grpname-> the name of the group we're adding (to)
               flags = flags
               id-> the id we're adding (or NULL if it's a comment)
               value-> the value to add (may be NULL for list groups)
 Returns:      NULL if successful, error pointer if not
 ******************************************************************/
_kernel_oserror *writevalue(optg *grps,char *grpname,int flags,char *id,char *value)
{
  opts *list=optg_find(grps,grpname);
  optval *oval;

  if (list==NULL)
  {
    list=opt_create(grpname,(opttype)(flags & 255));
    if (list==NULL)
    {
      return err_OutOfMemory; /* we could not create the options list group */
    }
    if (optg_add(grps,list))
    {
      opt_destroy(list);
      return err_OutOfMemory; /* erm... we couldn't add the group - PANIC! */
    }
  }

  if ((opttype)(flags & 255) != list->type)
    return err_CantConvert;

  switch (list->type)
  {
    case opt_options:
      oval=opt_findiopt(list,id);
      if (oval==NULL)
      { /* It's a new entry, so we must add it */
#ifdef DEBUG
        printf("Adding entry '%s:%s' in %s\n",id,value,grpname);
#endif
        if (opt_add(list,id,0,value))
          return err_OutOfMemory;
      }
      else
      {
#ifdef DEBUG
        printf("Changing value of '%s' to '%s' in %s\n",id,value,grpname);
#endif
        if (opt_change(oval,value))
          return err_OutOfMemory;
      }
      return NULL;

    case opt_list:
      {
        int num=(int)id;
        if (num==-1)
        { /* Add to end */
          if (opt_add(list,value,0,NULL))
            return err_OutOfMemory;
          return NULL;
        }
        printf("OptByNum: %i\n",num);
        oval=opt_findoptbynum(list,num);
        if (oval==NULL)
          return err_BadListItem;
        if (opt_changeid(oval,value))
          return err_OutOfMemory;
        return NULL;
      }
  }
  return NULL; /* Should never happen */
}

/*********************************************** <c> Gerph *********
 Function:     openfile
 Description:  Open a file and remember details about it, returning
               an opaque handle
 Parameters:   type = type of file access
               file-> the file to use
               app-> the application
               dir-> directory to use if not there
 Returns:      handle to use in future, or :
                 0 : invalid file access type
                 1 : file could not be read/out of memory
 ******************************************************************/
int openfile(opentype type, char *file, char *app, char *dir)
{
  optfile *thing;
  optg *opts;
  char write[os_FILE_NAME_LIMIT];
  char read[os_FILE_NAME_LIMIT];
  switch (type & 3)
  {
    case ot_absolute:
      strcpy(write,file);
      strcpy(read,file);
      break;

    case ot_choices:
      Config_GetFilename(read,file,app,dir,0);
      Config_GetFilename(write,file,app,dir,1);
      break;

    default:
      return BAD_OPENTYPE;
  }

  if ((fexists(read) & 3)==1)
    opts=optg_readfile(read);
  else
    opts=optg_create(); /* new file */

  if (opts==NULL)
    return BAD_CANTOPEN;

  thing=malloc(sizeof(optfile));
  if (!thing)
  {
    optg_destroy(opts);
    return BAD_OUTOFMEMORY; /* Out of memory */
  }
  thing->groups=opts;
  thing->writefile=mystrdup(write);
  thing->needtowrite=0;

  thing->next=List; List=thing; /* Link to chain */

  thing->magic=MAGIC;

  return ((int)thing) ^ ~1; /* nearly invert */
}

/*********************************************** <c> Gerph *********
 Function:     closefile
 Description:  Close a file, writing it out if necessary
 Parameters:   handle-> the file handle (non-opaque value)
 Returns:      pointer to error, or NULL if ok
 ******************************************************************/
_kernel_oserror *closefile(optfile *file)
{
  _kernel_oserror *err=NULL;
  file->magic=NULL; /* Remove all the magic from the world*/

  if (file->needtowrite)
  {
    /* Write out file */
    FILE *f=fopen(file->writefile,"w");
    if (f==NULL)
      err=err_CantWriteFile;
    else
    {
      optg_show(f,file->groups,"\n");
      fclose(f);
    }
  }

  /* now we unlink from the chain */
  {
    optfile *ptr=List;
    optfile **last=&List;
    while (ptr)
    {
      if (ptr==file)
        *last=ptr->next; /* We're unlinked */
      last=(optfile**)&ptr->next;
      ptr=*last;
    }
  }

  optg_destroy(file->groups);
  free(file->writefile);
  free(file);

  return err; /* none */
}

/******************************************************************
 Function:     closeall
 Description:  Close all files
 Parameters:   none
 Returns:      none
 ******************************************************************/
void closeall(void)
{
  optfile *ptr=List;
  List=NULL;
  while (ptr)
  {
    optfile *next=ptr->next;
    if (ptr->magic != MAGIC)
    {
      /* This is a corrupt entry. erm. we'll probably die in a moment.
         One possibility is abort at this point so that we don't take out
         the machine. */
    }
    closefile(ptr);
    ptr=next;
  }
}

/*********************************************** <c> Gerph *********
 Function:     getsafehandle
 Description:  Get a safe handle from the opaque value returned
 Parameters:   opaque = opaque handle to check and get the safe
               value from
 Returns:      handle to use, or NULL if it's invalid
 ******************************************************************/
optfile *getsafehandle(int handle)
{
  optfile *f;
  if ((handle & 3) != 2)
    return NULL;
  f=(optfile *)(handle ^ ~1); /* nearly invert */
  if (f->magic!=MAGIC)
    return NULL;
  return f;
}
