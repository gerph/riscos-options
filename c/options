/**************************************************** JRF *********
 Function:     readenum
 Description:  Read an enumeration
 Parameters:   string-> the string to match
               list-> the enumeration blocks list
 Returns:      index of the item, or -1 if not known
 ******************************************************************/
int readenum(char *string,char *list)
{
  int num=0;
  if (string==NULL || list==NULL)
    return -1;
  while (*list>=' ')
  {
    /* printf("Compare %s:%s\n",string,list); */
    if (mystricmp_toacomma(list,string,&list)==0)
      return num;
    while (*list>=' ' && *list!=',')
      list++;
    if (*list==',')
      list++;
    num++;
  }
  return -1;
}

/**************************************************** JRF *********
 Function:     readbool
 Description:  Read a boolean value
 Parameters:   str-> string to decode
 Returns:      0, 1, or -1 if not known
 ******************************************************************/
int readbool(char *str)
{
  int num=readenum(str,"0,"
                       "no,"
                       "off,"
                       "false,"
                       "true,"
                       "yes,"
                       "on,"
                       "1");
  if (num==-1)
    return -1;
  return num>3;
}

/**************************************************** JRF *********
 Function:     readgroup
 Description:  Read a whole group entry from a file
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for transfer
                        b0-7 = type
                                0 = options
                                1 = list
                                undefined
                        b8-31 = undefined
               buffer-> buffer to place data in
               buflen = buffer length (or -ve to return -ve length required)
 Returns:      size of data written (or -ve size of buffer, or 0 if error)
 ******************************************************************/
int readgroup(optg *grps,char *grpname,int flags,char *buffer,int buflen)
{
  int spaceneeded=0;
  opts *list=optg_find(grps,grpname);
  char **tags=(char **)buffer; /* Block holding id/value information */
  optval *oval;

  if (list==NULL)
    return 0; /* No such group */

  /* We really need to check that the type matches the known type */
  if (list->type!=(opttype)(flags & 255))
    return 0; /* lists can't be converted to options */

  oval=opt_firstopt(list);

  /* First we work out how much space we actually need (if requested) */
  switch (flags & 255)
  {
    case 0: /* options */
      spaceneeded=8; /* 8 bytes for terminator pair */
      buffer+=8;
      while (oval!=NULL)
      {
        if (opt_id(oval)!=NULL)
        {
          spaceneeded+=8; /* 4 for id ptr, 4 for value ptr */
          buffer+=8;      /* and the start of text buffer increases */
          spaceneeded+=strlen(opt_id(oval))+1;
          if (opt_value(oval))
            spaceneeded+=strlen(opt_value(oval))+1;
        }
        oval=opt_nextopt(oval);
      }
      break;

    case 1: /* list */
      spaceneeded=2; /* 2 bytes for terminator pair */
      while (oval!=NULL)
      {
        if (opt_id(oval)!=NULL)
        {
          spaceneeded+=strlen(opt_id(oval))+1;
        }
        oval=opt_nextopt(oval);
      }
      break;

     default: /* Unknown */
      return 0; /* We know nothing about that format, thanks */
  }

  if (tags==NULL || buflen<spaceneeded)
  {
#ifdef DEBUG
    printf("readgroup: not enough room; need %i, got %i\n",spaceneeded,buflen);
#endif
    return -spaceneeded;
  }

  oval=opt_firstopt(list);
  switch (flags & 255)
  {
    case 0: /* Options */
      while (oval)
      {
        char *id,*value;
        id=opt_id(oval);
        if (id!=NULL)
        {
#ifdef DEBUG
          printf("readgroup: fill id: %s\n",id);
#endif
          *tags++=buffer;
           strcpy(buffer,id);
           buffer+=strlen(id)+1;
          value=opt_value(oval);
#ifdef DEBUG
          printf("readgroup: fill value: %s\n",id ? id : "[None]");
#endif
          if (value!=NULL)
          {
            *tags++=buffer;
            strcpy(buffer,value);
            buffer+=strlen(value)+1;
          }
          else
          {
            *tags++=NULL;
          }
        }
        oval=opt_nextopt(oval);
      }
      *tags++=NULL;
      *tags++=NULL;
      break;

    case 1: /* List */
      while (oval)
      {
        char *id;
        id=opt_id(oval);
        if (id!=NULL)
        {
          strcpy(buffer,id);
          buffer+=strlen(id)+1;
        }
        oval=opt_nextopt(oval);
      }
      *buffer++='\0';
      *buffer++='\0';
      break;
  }

  return spaceneeded;
}

/**************************************************** JRF *********
 Function:     writegroup
 Description:  Write out a group
 Parameters:   grps-> the file we're reading from
               grpname-> the group name to read from
               flags = flags for transfer
                        b0-7 = type
                                0 = options
                                1 = list
                                undefined
                        b8-31 = undefined
               buffer-> buffer to read data from
 Returns:      error block if error
 ******************************************************************/
_kernel_oserror *writegroup(optg *grps,char *grpname,int flags,char **buffer)
{
  opts *list=optg_find(grps,grpname);

  if (list==NULL)
  {
#ifdef DEBUG
    printf("Group doesn't exist; creating...\n");
#endif
    list=opt_create(grpname,(opttype)(flags & 255)); /* Create an empty group */
    if (list==NULL)
      return err_OutOfMemory;
    if (optg_add(grps,list))
    {
      opt_destroy(list);
      return err_OutOfMemory;
    }
  }

  switch (flags & 255)
  {
    case 0:
      { /* For the options list we have to merge the lists - that's fun */
        char **entry=(char **)buffer;
        optval *current;

        while (entry[0] || entry[1])
        {
          optval *find;
          if (entry[0]!=NULL)
          {
#ifdef DEBUG
            printf("Looking at %s\n",entry[0]);
#endif
            find=opt_findiopt(list,entry[0]);
            if (find==NULL)
            {
#ifdef DEBUG
              printf("Not found, so adding it...\n");
#endif
              if (opt_add(list,entry[0],0,entry[1]))
                return err_OutOfMemory;
            }
            else
            {
#ifdef DEBUG
              printf("Found entry; changing it\n");
#endif
              if (opt_change(find,entry[1]))
                return err_OutOfMemory;
            }
          }
          else
          { /* A comment line */
            opt_add(list,NULL,0,entry[1]);
          }

          entry+=2;
        }

        current=opt_firstopt(list);

#ifdef DEBUG
        printf("Looking for dead entries\n");
#endif
        while (current)
        {
          optval *next=opt_nextopt(current);
          char *id=opt_id(current);
          if (id)
          {
            char **entry=(char **)buffer;
#ifdef DEBUG
            printf("Looking at %s\n",id);
#endif
            while (entry[0] || entry[1])
            {
              if (entry)
              {
                if (mystricmp(entry[0],id)==0)
                  break;
              }
              entry+=2;
            }
            if (!(entry[0] || entry[1]))
              opt_remove(list,current);
          }
          current=next;
        }
      }
      return NULL;
      break;

    case 1:
      { /* Basically we need to destroy the entire list then reconstruct it.
           it's not as complex as the options format */
        char *entry=(char *)buffer;
        optval *current;

        /* Remove all current entries */
        current=opt_firstopt(list);
        while (current)
        {
          optval *next=opt_nextopt(current);
          opt_remove(list,current);
          current=next;
        }

        /* Now add the entries we've been given */
        while (*entry)
        {
          opt_add(list,entry,0,NULL);
          entry+=strlen(entry)+1;
        }
      }
      break;
  }
  return err_BadType;
}

