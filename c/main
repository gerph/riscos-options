#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include "optlist.h"
#include "choices.h"
#include "options.h"

/* From OSLib */
#include "os.h"

/* #define TEST_READFILE */
/* #define TEST_CREATEFILE */
/* #define TEST_FILENAMING */
/* #define TEST_OPTIONS_READ_OPTIONS */
/* #define TEST_OPTIONS_READ_LIST */
/* #define TEST_LIST_READ_OPTIONS */
/* #define TEST_LIST_READ_LIST */
/* #define TEST_WRITE_GROUP */
/* #define TEST_CLOSEFILE */

int main(void)
{
#ifdef TEST_READFILE
  optg *opts=optg_readfile("options");
  if (opts==NULL)
    printf("[No file read]\n");
  else
    optg_show(stdout,opts,"\n");
#endif

#ifdef TEST_CREATEFILE
  /* Test 'create file' */
  ensuredir("alt.binaries.pictures.porn.helen.rayner"); /* <giggle> */
  ensuredir("testing");
#endif

#ifdef TEST_FILENAMING
  /* Test 'Get name of options file' */
  {
    char read[os_FILE_NAME_LIMIT];
    char write[os_FILE_NAME_LIMIT];
    system("Set Choices$Write @.test.Choices");
    system("Set Choices$Path  @.test.Choices.");
#define TEST(y,z) Config_GetFilename(read,"Test",y,z,0); \
                  Config_GetFilename(write,"Test",y,z,1); \
                  printf("Read  %s,%s -> %s\n",y,z,read); \
                  printf("Write %s,%s -> %s\n",y,z,write);
    TEST("Forecast","test.Forecast");
    TEST("WWW.Browse","test.www.browse");
  }
#endif

#ifdef TEST_OPTIONS_READ_OPTIONS
  printf(">test the group \"options reading options\" code\n");
  {
    int size;
    char *buffer;
    optg *grp=optg_readfile("Options");
    if (grp==NULL)
    {
      printf("Failed to open options file\n");
    }
    else
    {
      size=readgroup(grp,"group2",0,NULL,-1);
      printf("Find group 'group2' gave %i\n",size);
      if (size!=0)
      {
        int read;
        char **data;
        buffer=malloc(-size);
        read=readgroup(grp,"group2",0,buffer,-size);
        if (read!=-size)
          printf("Size read is not the size requested\n");
        printf("Read group data; got = %i\n",read);
        data=(char**)buffer;
        while (*data!=NULL)
        {
          char *id,*value;
          id=*data++;
          value=*data++;
          /* printf("%p: %p\n",id,value); */
          printf("%s: %s\n",id,value ? value : "[None]");
        }
      }
      optg_destroy(grp);
    }
  }
#endif

#ifdef TEST_OPTIONS_READ_LIST
  printf(">test the group \"options reading list\" code\n");
  {
    int size;
    char *buffer;
    optg *grp=optg_readfile("Options");
    if (grp==NULL)
    {
      printf("Failed to open options file\n");
    }
    else
    {
      size=readgroup(grp,"list group",0,NULL,-1);
      printf("Find group 'list group' gave %i\n",size);
      if (size!=0)
      {
        int read;
        char **data;
        buffer=malloc(-size);
        read=readgroup(grp,"list group",0,buffer,-size);
        if (read!=-size)
          printf("Size read is not the size requested\n");
        printf("Read group data; got = %i\n",read);
        data=(char**)buffer;
        while (*data!=NULL)
        {
          char *id,*value;
          id=*data++;
          value=*data++;
          /* printf("%p: %p\n",id,value); */
          printf("%s: %s\n",id,value ? value : "[None]");
        }
      }
      optg_destroy(grp);
    }
  }
#endif

#ifdef TEST_LIST_READ_OPTIONS
  printf(">test the group \"list reading options\" code\n");
  {
    int size;
    char *buffer;
    optg *grp=optg_readfile("Options");
    if (grp==NULL)
    {
      printf("Failed to open options file\n");
    }
    else
    {
      size=readgroup(grp,"group2",1,NULL,-1);
      printf("Find group 'group2' gave %i\n",size);
      if (size!=0)
      {
        int read;
        char *ptr;
        buffer=malloc(-size);
        read=readgroup(grp,"group2",1,buffer,-size);
        if (read!=-size)
          printf("Size read is not the size requested\n");
        printf("Read group data; got = %i\n",read);
        ptr=buffer;
        while (*ptr!='\0')
        {
          printf("%s\n",ptr);
          ptr+=strlen(ptr)+1;
        }
      }
      optg_destroy(grp);
    }
  }
#endif

#ifdef TEST_LIST_READ_LIST
  printf(">test the group \"list reading list\" code\n");
  {
    int size;
    char *buffer;
    optg *grp=optg_readfile("Options");
    if (grp==NULL)
    {
      printf("Failed to open options file\n");
    }
    else
    {
      size=readgroup(grp,"list group",1,NULL,-1);
      printf("Find group 'list group' gave %i\n",size);
      if (size!=0)
      {
        int read;
        char *ptr;
        buffer=malloc(-size);
        read=readgroup(grp,"list group",1,buffer,-size);
        if (read!=-size)
          printf("Size read is not the size requested\n");
        printf("Read group data; got = %i\n",read);
        ptr=buffer;
        while (*ptr!='\0')
        {
          printf("%s\n",ptr);
          ptr+=strlen(ptr)+1;
        }
      }
      optg_destroy(grp);
    }
  }
#endif

#ifdef TEST_WRITE_GROUP
  /* Test that write group works */
  {
    /* optg *grp=optg_create(); */
    optg *grp=optg_readfile("Options");
    if (grp==NULL)
    {
      printf("Failed to create options block\n");
    }
    else
    {
      _kernel_oserror *err;
      char *data[] =
      {
        NULL, "This is a comment",
        "Justin",  "Helen",
        "Matthew", "Claire",
        "Simon", "Nothing",
        NULL, NULL
      };
      printf("Created group ok\n");
      err=writegroup(grp,"$",0,data);
      if (err)
        printf("Error writing: %s\n",err->errmess);
      else
      {
        printf("Wrote group\n");
        optg_show(stdout,grp,"\n");
      }
    }
  }
#endif

#ifdef TEST_CLOSEFILE
  /* Test that closing a file works */
#endif

}
