/*********************************************** <c> Gerph *********
 Function:     Config_SetFEFlag
 Description:  Write a configuration flag to FrontEnd
 Parameters:   id-> the id to read
               flag = flag to write
 Returns:      0 if successful, 1 otherwise
 ******************************************************************/
int Config_SetFEFlag(char *id,int flag)
{
  if (flag)
    return Config_SetFEStr(id,"On");
  return Config_SetFEStr(id,"Off");
}

