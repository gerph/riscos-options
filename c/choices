/*********************************************** <c> Gerph *********
 Function:     Config_GetFEFlag
 Description:  Read a configuration flag from FrontEnd
 Parameters:   id-> the id to read
 Returns:      number, or -1 if not found
 ******************************************************************/
int Config_GetFEFlag(char *id)
{
  optval *ent=opt_findiopt(FEOpts,id);
  char *val;
#ifdef DEBUG
  { void __swi(0x104) vdu4(void); vdu4(); }
  printf("Config_GetFEFlag: '%s' = %p\n",id,ent);
#endif
  if (ent==NULL)
    return 0;
  val=opt_value(ent);
  if ( (stricmp(val,"1")==0) ||
       (stricmp(val,"on")==0) ||
       (stricmp(val,"true")==0) ||
       (stricmp(val,"set")==0) )
    return 1;
  return 0;
}

