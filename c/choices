/*********************************************** <c> Gerph *********
 Function:     cdir
 Description:  Create a directory
 Parameters:   dir-> directory name
 Returns:      0 if successful, 1 if failed
 ******************************************************************/
int cdir(char *dir)
{
  return _swix(OS_File,_INR(0,1) | _IN(4),8,dir,0)!=NULL;
}

void settype(char *file,int type)
{
  _swix(OS_File,_INR(0,2),18,file,type);
}

/**************************************************** JRF *********
 Function:     fexists
 Description:  Does a file/directory exist ?
 Parameters:   file-> filename
 Returns:      0 if nothing there,
               1 if file
               2 if directory
               3 if image
 ******************************************************************/
int fexists(char *file)
{
  int obj;
  if (_swix(OS_File,_INR(0,1) | _OUT(0),5,file,&obj))
    return 0;

  return obj;
}

/**************************************************** JRF *********
 Function:     copyfile
 Description:  Copies a file
 Parameters:   old-> old filename
               new-> new filename
 Returns:      0 if ok, 1 if failed
 ******************************************************************/
int copyfile(char *old,char *new)
{
  return _swix(OS_FSControl,_INR(0,3),26,old,new,1<<1)!=NULL;
}

/**************************************************** JRF *********
 Function:     ensuredir
 Description:  Ensures that the directory of a path exists
 Parameters:   dir-> directory to ensure
 Returns:      none
 ******************************************************************/
void ensuredir(char const *dir)
{
  char newdir[os_FILE_NAME_LIMIT];
  char *dot;
  char *nextdot;
  int len;

  if (strrchr(dir,'.')==NULL)
    return; /* No dot's so we abort right now */

  strcpy(newdir,dir);
  do
  {
    dot=strrchr(newdir,'.');
    if (dot!=NULL)
      *dot='\0';
  } while (dot!=NULL && fexists(newdir)==0);

  /* Right, so we know that the thing pointed to by newdir exists */
  len=strlen(newdir);
  do
  {
    printf("Creating %s\n",newdir);
    cdir(newdir);
    newdir[len]='.'; /* Append the seperator */
    nextdot=strchr(&dir[len+1],'.');
    if (nextdot!=NULL)
    {
      memcpy(&newdir[len],&dir[len],nextdot-&dir[len]);
      len+=nextdot-&dir[len];
    }
  } while (nextdot);
}

/*********************************************** <c> Gerph *********
 Function:     Config_GetFilename
 Description:  Read the name of a config file
 Parameters:   buffer-> buffer to write into (os_FILE_NAME_LIMIT long)
               name-> the name to read
               app-> the application name
               dir-> default directory to use
               write = 1 if we want write access to the file
 Returns:      pointer to static filename
 ******************************************************************/
char *Config_GetFilename(char *buffer,char *name,char *app,char *dir,int write)
{
  if (getenv("Choices$Write")==NULL)
  {
    /* we cannot use Choices (probably non-RPC) */
    sprintf(buffer,"%s.%s",dir,name);
  }
  else
  {
    if (write)
    {
      sprintf(buffer,"<Choices$Write>.%s.%s",app,name);
      ensuredir(buffer);
    }
    else
    {
      sprintf(buffer,"Choices:%s.%s",app,name);
      if (fexists(buffer)==0)
      {
        /* The file doesn't exist. We must copy the non-Choices: version
           over it */
        char buffer2[os_FILE_NAME_LIMIT];
        sprintf(buffer,"%s.%s",dir,name); /* original */
        sprintf(buffer2,"<Choices$Write>.%s.%s",app,name); /* new */
        ensuredir(buffer2);
        copyfile(buffer,buffer2);
      }
    }
  }

#ifdef DEBUG
  { void __swi(0x104) vdu4(void); vdu4(); }
  printf("Config_GetFilename: %s, %s, %i\n",name,app,write);
  printf("                  = \"%s\"\n",buffer);
#endif
  return buffer;
}
